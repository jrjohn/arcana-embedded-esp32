# MQTT5 Protocol
CONFIG_MQTT_PROTOCOL_5=y

# Command-channel encryption (AES-256-CCM + ECDH P-256 session keys).
# Enables CryptoEngine + KeyExchangeManager for BLE and MQTT commands.
# The 256-bit PSK is a per-deployment provisioning secret and is NOT committed:
# override CONFIG_CMD_ENCRYPTION_PSK in the (git-ignored) sdkconfig before a
# production build. The Kconfig default is an all-placeholder key — do NOT ship it.
CONFIG_CMD_ENCRYPTION_ENABLED=y

# Bluetooth (Bluedroid BLE Dual-Role)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4096
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_GATT_MAX_SR_PROFILES=3
CONFIG_BT_ACL_CONNECTIONS=3
CONFIG_BT_MULTI_CONNECTION_ENBALE=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# WiFi + BLE Coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# OTA: new images boot PENDING_VERIFY; AppContainer marks them valid after
# all services come up — a crash before that point auto-rolls-back to the
# previous slot. (No effect on the classic 4MB factory-only table.)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CI: Flash size override. ESPTOOLPY_FLASHSIZE (the string) is auto-derived
# from whichever ESPTOOLPY_FLASHSIZE_*MB choice is selected — don't set it
# directly; in IDF 6.0 kconfig will warn that the user-set string is being
# dropped.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS 1KHz tick (needed for 1ms ECG pacing)
CONFIG_FREERTOS_HZ=1000

# Main task stack (ECDH + HTTPS registration needs ~8KB)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Allow TLS without cert verification (dev mode)
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# FatFS for SD card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# exFAT (single file >4GB) was evaluated but NOT enabled: ESP-IDF v6.0.1 has no
# exFAT Kconfig, and flipping FF_FS_EXFAT=1 in the bundled ffconf.h fails to build
# (dangling CONFIG_FATFS_USE_LABEL — ESP-IDF's ffconf is incomplete for exFAT;
# verified 2026-06-09). The raw-FatFs FatFsFilePort already lifts a FAT32 single
# file from 2GB to 4GB, which covers ECG ~2.4GB/day. Revisit exFAT (needs ffconf
# surgery + vendoring the fatfs component) only if a daily file must exceed 4GB.

# TLS: reduce memory for HTTPS upload on heap-constrained ESP32.
# MBEDTLS_DYNAMIC_BUFFER was removed in IDF 6.0; MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH
# (which used to be mutually-exclusive) now serves the same purpose and is the
# only supported way.
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# TCP tuning for WAN uploads (2026-06-10).
# MSS 1280 (packet = 1320B): lwIP has NO path-MTU blackhole detection — a hop
# with MTU < 1480 (e.g. an ISP/tunnel uplink; we hit a gateway WAN at MTU 1359)
# silently eats full-size 1440-MSS segments: handshake/headers pass, every bulk
# data segment dies, uploads stall forever at ~0%. 1320 fits virtually all real
# paths. (The site firewall now also clamps MSS, but devices roam — 4G hotspots,
# other sites — so keep the device self-sufficient.)
# SND_BUF/WND 46080 (= 36 × 1280): the old 5760 allowed only ~4 segments in
# flight — at WAN RTTs that caps throughput to a crawl. Heap cost is fine on
# both targets (upload runs with BLE deinited; S3 has PSRAM).
CONFIG_LWIP_TCP_MSS=1280
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=46080
CONFIG_LWIP_TCP_WND_DEFAULT=46080

# CI: IRAM optimization (overflow fix). FREERTOS_PLACE_FUNCTIONS_INTO_FLASH
# and RINGBUF_PLACE_FUNCTIONS_INTO_FLASH became the default in IDF 6.0 and
# are no longer kconfig switches.
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_MQTT_CUSTOM_OUTBOX=n
# HAL_DEFAULT_ASSERTION_LEVEL is auto-derived; pick the right HAL_ASSERTION_*
# bool to drive it. _DISABLE → level 0.
CONFIG_HAL_ASSERTION_DISABLE=y
