# MQTT5 Protocol
CONFIG_MQTT_PROTOCOL_5=y

# Bluetooth (Bluedroid BLE Dual-Role)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4096
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_GATT_MAX_SR_PROFILES=3
CONFIG_BT_ACL_CONNECTIONS=3
CONFIG_BT_MULTI_CONNECTION_ENBALE=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# WiFi + BLE Coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# OTA: new images boot PENDING_VERIFY; AppContainer marks them valid after
# all services come up — a crash before that point auto-rolls-back to the
# previous slot. (No effect on the classic 4MB factory-only table.)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CI: Flash size override. ESPTOOLPY_FLASHSIZE (the string) is auto-derived
# from whichever ESPTOOLPY_FLASHSIZE_*MB choice is selected — don't set it
# directly; in IDF 6.0 kconfig will warn that the user-set string is being
# dropped.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS 1KHz tick (needed for 1ms ECG pacing)
CONFIG_FREERTOS_HZ=1000

# Main task stack (ECDH + HTTPS registration needs ~8KB)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Allow TLS without cert verification (dev mode)
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# FatFS for SD card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# exFAT: lets a single .ats exceed 4GB (FSIZE_t becomes 64-bit) — parity with the
# STM32 build (which uses FF_FS_EXFAT=1). FatFs still mounts FAT32 too, so existing
# FAT32 cards keep working (and now reach 4GB via the raw-FatFs FatFsFilePort).
# VERIFY: confirm this Kconfig exists in ESP-IDF v6 (idf.py menuconfig → Component
# config → FAT Filesystem support). If absent, enable exFAT via a main/ ffconf.h
# override (FF_FS_EXFAT=1). exFAT carries Microsoft IP terms — product/legal sign-off.
CONFIG_FATFS_EXFAT_ENABLED=y

# TLS: reduce memory for HTTPS upload on heap-constrained ESP32.
# MBEDTLS_DYNAMIC_BUFFER was removed in IDF 6.0; MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH
# (which used to be mutually-exclusive) now serves the same purpose and is the
# only supported way.
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# TCP: keep defaults (5760) — larger values eat too much heap on ESP32
# CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
# CONFIG_LWIP_TCP_WND_DEFAULT=5760

# CI: IRAM optimization (overflow fix). FREERTOS_PLACE_FUNCTIONS_INTO_FLASH
# and RINGBUF_PLACE_FUNCTIONS_INTO_FLASH became the default in IDF 6.0 and
# are no longer kconfig switches.
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_MQTT_CUSTOM_OUTBOX=n
# HAL_DEFAULT_ASSERTION_LEVEL is auto-derived; pick the right HAL_ASSERTION_*
# bool to drive it. _DISABLE → level 0.
CONFIG_HAL_ASSERTION_DISABLE=y
