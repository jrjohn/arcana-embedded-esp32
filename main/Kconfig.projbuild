menu "Arcana Timer Configuration"

    config TIMER_FAST_INTERVAL_MS
        int "Fast timer interval (ms)"
        default 100
        range 10 1000
        help
            Interval in milliseconds for the fast periodic timer.
            This is the esp_timer period. Services needing high-frequency
            ticks (e.g. LED cycling) subscribe to FastTimer.

    config TIMER_BASE_INTERVAL_MS
        int "Base timer interval (ms)"
        default 1000
        range 100 10000
        help
            Interval in milliseconds for the base periodic timer.
            Derived from the fast timer via a counter divider.
            Must be a multiple of TIMER_FAST_INTERVAL_MS.

endmenu

menu "Arcana MQTT Configuration"

    config BROKER_URL
        string "Broker URL"
        default "mqtt://127.0.0.1:1883"
        help
            URL of the broker to connect to

    config BROKER_URL_FROM_STDIN
        bool
        default y if BROKER_URL = "FROM_STDIN"

endmenu


menu "Arcana OTA Configuration"

    config EXAMPLE_FIRMWARE_UPG_URL
        string "Firmware Upgrade URL"
        default "https://192.168.2.106:8070/hello-world.bin"
        help
            URL of server which hosts the firmware image.

    config EXAMPLE_FIRMWARE_UPGRADE_URL_FROM_STDIN
        bool
        default y if EXAMPLE_FIRMWARE_UPG_URL = "FROM_STDIN"

    config EXAMPLE_SKIP_COMMON_NAME_CHECK
        bool "Skip server certificate CN fieldcheck"
        default n
        help
            This allows you to skip the validation of OTA server certificate CN field.

    config EXAMPLE_SKIP_VERSION_CHECK
        bool "Skip firmware version check"
        default n
        help
            This allows you to skip the firmware version check.

    config EXAMPLE_GPIO_DIAGNOSTIC
        int "Number of the GPIO input for diagnostic"
        range 0 39
        default 4
        help
            Used to demonstrate how a rollback works.
            The selected GPIO will be configured as an input with internal pull-up enabled.
            To trigger a rollback, this GPIO must be pulled low while the message
            `Diagnostics (5 sec)...` which will be on first boot.
            If GPIO is not pulled low then the operable of the app will be confirmed.

    config EXAMPLE_OTA_RECV_TIMEOUT
        int "OTA Receive Timeout"
        default 5000
        help
            Maximum time for reception

endmenu

menu "I2C Configuration"

    menu "I2C 0 Master"
        config I2C_0_MASTER_SCL
            int "SCL GPIO Num 0"
            default 2
            help
                GPIO number for I2C Master clock line.

        config I2C_0_MASTER_SDA
            int "SDA GPIO Num 0"
            default 1
            help
                GPIO number for I2C Master data line.

        config I2C_MASTER_PORT_NUM_0
            int "Port Number 0"
            default 0
            help
                Port number for I2C Master device.

        config I2C_0_MASTER_FREQUENCY
            int "I2C 0 Frequency"
            default 200000
            help
                I2C Speed of Master device.
    endmenu

    menu "I2C 1 Master"
        config I2C_1_MASTER_SCL
            int "SCL GPIO Num 1"
            default 0
            help
                GPIO number for I2C Master clock line.

        config I2C_1_MASTER_SDA
            int "SDA GPIO Num 1"
            default 38
            help
                GPIO number for I2C Master data line.

        config I2C_MASTER_PORT_NUM_1
            int "Port Number 1"
            default 1
            help
                Port number for I2C Master device.

        config I2C_1_MASTER_FREQUENCY
            int "I2C 1 Frequency"
            default 200000
            help
                I2C Speed of Master device.
    endmenu

endmenu

menu "zlib Configuration"

    config ENABLE_GZIP_ENCODING
        bool "Enable GZIP encoding support"
        default y
        help
            Optional GZIP encoding
            Enable when data is to be archived to .gz format

    config GZIP_ENCODING
        int
        default 16
        default 16 if ENABLE_GZIP_ENCODING

    config WINDOW_SIZE
        int "Dictionary window size"
        range 8 15
        default 12
        help
            Base two logarithm of the window size: the size of the history buffer
            looked at by the algorithm for self-similar data it can compress.
            Larger values of this parameter result in better compression at the expense of memory usage.
            Note: 12 => 2^12 = 4096 bytes

    config MEM_LEVEL
        int "Memory Level: See help"
        range 1 9
        default 3
        help
            How much memory should be allocated for the internal compression state
            1 for using minimum memory but is slow and reduces compression ratio.
            9 for using maximum memory for optimal speed.

    config COMPRESSION_LEVEL
        int "Compression level: See help"
        range -1 9
        default -1
        help
            Denotes the compression level to be achieved.
            -1 for default compression
            0 for no compression
            1 for best speed, low compression
            9 for best compression, low speed

    config COMPRESSION_STRATEGY
        int "Compression Strategy: See help"
        range 0 5
        default 0
        help
            Compression strategy depending on the type of data
            0 for Default (for normal data)
            1 for Filtered (for data produced by a filter or predictor)
            2 for Huffman only (force more Huffman encoding, less string matching)
            3 for RLE (Similar to Huffman only, best suited for PNG format)
            4 for Fixed (No Dynamic Huffman encoding, suited for simpler applications)

endmenu

# ── merged from components/ObservableSensor/Kconfig ─────────────────────────
menu "Observable Sensor Configuration"

    config OBSERVABLE_SENSOR_TASK_STACK_SIZE
        int "Sensor task stack size"
        default 4096
        help
            Stack size for the sensor reading task.

    config OBSERVABLE_SENSOR_TASK_PRIORITY
        int "Sensor task priority"
        default 5
        help
            Priority for the sensor reading task.

    config OBSERVABLE_SENSOR_DEFAULT_INTERVAL_MS
        int "Default reading interval (ms)"
        default 1000
        help
            Default interval between sensor readings in milliseconds.

    menu "DHT Sensor"

        choice DHT_SENSOR_TYPE
            prompt "DHT sensor type"
            default DHT_SENSOR_TYPE_DHT11
            help
                Select the DHT sensor model.

            config DHT_SENSOR_TYPE_DHT11
                bool "DHT11"
            config DHT_SENSOR_TYPE_DHT22
                bool "DHT22 / AM2302"
        endchoice

        config DHT_SENSOR_GPIO
            int "DHT data GPIO pin"
            default 40 if IDF_TARGET_ESP32S3
            default 15
            range 0 48 if IDF_TARGET_ESP32S3
            range 0 39
            help
                GPIO pin connected to the DHT sensor data line.
                DNESP32S3: the onboard DHT11 socket (U4) routes to IO40 via
                the P5 jumper (1WIRE_DQ <-> LCD_DC pair).

        config DHT_SENSOR_READ_INTERVAL_MS
            int "DHT reading interval (ms)"
            default 2000
            range 1000 60000
            help
                Interval between DHT sensor readings.
                DHT11 minimum is ~1s, DHT22 minimum is ~2s.

    endmenu

endmenu

# ── merged from components/OledDisplay/Kconfig ──────────────────────────────
menu "OLED Display Configuration"

    config OLED_SCL_GPIO
        int "I2C SCL GPIO pin"
        default 42 if IDF_TARGET_ESP32S3
        default 22
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 33
        help
            GPIO pin for I2C SCL (clock) to SSD1306 OLED.
            DNESP32S3: IO42 is the board's shared I2C0 bus (2.2K pullups);
            no SSD1306 is fitted — the app degrades gracefully if absent.

    config OLED_SDA_GPIO
        int "I2C SDA GPIO pin"
        default 41 if IDF_TARGET_ESP32S3
        default 21
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 33
        help
            GPIO pin for I2C SDA (data) to SSD1306 OLED.
            DNESP32S3: IO41 is the board's shared I2C0 bus.

    config OLED_I2C_ADDR
        hex "SSD1306 I2C address"
        default 0x3C
        help
            I2C address of the SSD1306 OLED display.
            Common values: 0x3C or 0x3D.

endmenu

# ── merged from components/BleService/Kconfig ───────────────────────────────
menu "BLE Service Configuration"

    config BLE_DEVICE_NAME
        string "BLE device name"
        default "ARCANA-ESP32S3"
        help
            The BLE device name advertised during GAP advertising.

    config BLE_SCAN_DURATION
        int "BLE scan duration (seconds)"
        default 30
        range 0 300
        help
            Duration of BLE scanning in seconds. Set to 0 for continuous scan.

    config BLE_TARGET_SERVICE_UUID
        hex "Target BLE service UUID (16-bit)"
        default 0x181A
        help
            16-bit UUID of the BLE service to scan for when acting as GATT Client.

    config BLE_MAX_CONNECTIONS
        int "Maximum BLE connections"
        default 3
        range 1 6
        help
            Maximum number of simultaneous BLE connections (server + client).

    config BLE_NOTIFY_INTERVAL_MS
        int "BLE notify interval (ms)"
        default 1000
        range 100 60000
        help
            Interval between BLE notifications to connected clients.

endmenu

# ── merged from components/MqttService/Kconfig ──────────────────────────────
menu "MQTT Service Configuration"

    config MQTT_SVC_CMD_TOPIC
        string "MQTT command topic"
        default "arcana/cmd"
        help
            MQTT topic for receiving commands.

    config MQTT_SVC_RSP_TOPIC
        string "MQTT response topic"
        default "arcana/rsp"
        help
            MQTT topic for publishing responses.

    config MQTT_SVC_USERNAME
        string "MQTT username"
        default ""
        help
            MQTT broker username. Leave empty for anonymous.

    config MQTT_SVC_PASSWORD
        string "MQTT password"
        default ""
        help
            MQTT broker password.

endmenu

# ── merged from components/RgbLed/Kconfig ───────────────────────────────────
menu "RGB LED Configuration"

    config RGB_LED_GPIO
        int "WS2812B data GPIO pin"
        default 1 if IDF_TARGET_ESP32S3
        default 26
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 33
        help
            GPIO pin connected to the WS2812B data line.
            DNESP32S3 has no WS2812B; IO1 drives the onboard red LED
            (510R) so the RMT waveform shows as a faint activity glow.

    config RGB_LED_NUM_LEDS
        int "Number of LEDs"
        default 3
        range 1 256
        help
            Number of WS2812B LEDs in the strip.

    config RGB_LED_CYCLE_INTERVAL_MS
        int "Color cycle interval (ms)"
        default 1000
        range 100 10000
        help
            Interval between color changes during cycling.

endmenu

# ── ATS storage (SD card over SDSPI) ────────────────────────────────────────
menu "ATS Storage Configuration"

    config ATS_SD_CLK_GPIO
        int "SD card SPI CLK GPIO"
        default 12 if IDF_TARGET_ESP32S3
        default 4
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 33
        help
            SPI clock pin for the SD card (SDSPI mode).
            DNESP32S3 onboard TF slot: CLK=12.

    config ATS_SD_MOSI_GPIO
        int "SD card SPI MOSI GPIO"
        default 11 if IDF_TARGET_ESP32S3
        default 32
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 33
        help
            SPI MOSI pin for the SD card.
            DNESP32S3 onboard TF slot: MOSI=11.

    config ATS_SD_MISO_GPIO
        int "SD card SPI MISO GPIO"
        default 13 if IDF_TARGET_ESP32S3
        default 17
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 39
        help
            SPI MISO pin for the SD card.
            DNESP32S3 onboard TF slot: MISO=13.

    config ATS_SD_CS_GPIO
        int "SD card SPI CS GPIO"
        default 2 if IDF_TARGET_ESP32S3
        default 27
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 33
        help
            SPI chip-select pin for the SD card.
            DNESP32S3 onboard TF slot: CS=2 (shared with REMOTE_IN).

    config ATS_SD_MAX_FREQ_KHZ
        int "SD card SPI max frequency (kHz)"
        default 4000
        range 400 40000
        help
            4 MHz suits breadboard wiring + level shifters (classic ESP32
            DevKit setup) and is also the proven-stable speed for the
            DNESP32S3 onboard TF slot: 20 MHz there passed one boot, then
            produced FR_DISK_ERR on every write on later boots (47K-only
            pullups, SPI2 shared with the wireless/SPI-LCD socket via P5
            jumpers). Raise with caution and soak-test.

    config ATS_SD_BENCHMARK_ON_BOOT
        bool "Run SD write benchmark once at boot"
        default n
        help
            Runs SdBenchmarkService after the SD card is mounted and logs
            sequential-write speed. Diagnostics only — leave off in
            production builds.

    config ATS_SD_BENCHMARK_DURATION_MS
        int "SD benchmark duration (ms)"
        depends on ATS_SD_BENCHMARK_ON_BOOT
        default 10000
        range 1000 60000
        help
            How long the boot benchmark writes 4KB blocks.

endmenu

# ── merged from components/CommandService/Kconfig ───────────────────────────
menu "Command Service Configuration"

    config CMD_QUEUE_STACK_SIZE
        int "Command queue task stack size"
        default 4096
        range 2048 8192
        help
            Stack size for the async command processing task.

    config CMD_MQTT_CMD_TOPIC
        string "MQTT command topic"
        default "arcana/cmd"
        help
            MQTT topic to subscribe for incoming commands.

    config CMD_MQTT_RSP_TOPIC
        string "MQTT response topic"
        default "arcana/rsp"
        help
            MQTT topic for publishing command responses.

    config CMD_ENCRYPTION_ENABLED
        bool "Enable command encryption (AES-256-CCM)"
        default n
        help
            Enable AES-256-CCM encryption for command protocol.
            Both BLE and MQTT channels use the same encryption.

    config CMD_ENCRYPTION_PSK
        string "Pre-shared key (64 hex chars = 256-bit)"
        default "00112233445566778899AABBCCDDEEFF00112233445566778899AABBCCDDEEFF"
        depends on CMD_ENCRYPTION_ENABLED
        help
            256-bit AES key as hex string (64 characters).

endmenu
